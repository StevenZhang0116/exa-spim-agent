#!/usr/bin/env bash

set -euo pipefail

setup_google_creds() {
    # Fail fast if GCS_TOKEN is not set or empty
    : "${GCS_TOKEN:?GCS_TOKEN environment variable is not set or empty}"

    # Create a temporary file
    TEMP_CRED_FILE=$(mktemp --suffix=".json")

    # Ensure temporary file is removed on script exit or interrupt
    trap "rm -f \"$TEMP_CRED_FILE\"" EXIT

    # Write the environment variable content to the temporary file
    printf '%s' "${GCS_TOKEN}" > "$TEMP_CRED_FILE"

    export GOOGLE_APPLICATION_CREDENTIALS="$TEMP_CRED_FILE"

}

setup_google_creds

export AWS_REGION=us-west-2

# main.py is the only entrypoint; forward every argument through unchanged
# (App Panel supplies --result_prefix and --upload as named parameters).
python -u main.py "$@"
