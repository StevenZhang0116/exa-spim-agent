# Evolution runs: ignore the entire directory (large/local artifacts).
proofreader_evolve/runs/

# Prepared-brain shared cache: the cached pickles are large (~1.6 GB each) and
# fully rebuildable, so keep them local. Track the folder + its README only.
proofreader_evolve/prepared_cache/*
!proofreader_evolve/prepared_cache/README.md

# Autodiscovery: ignore the generated .fixed and .rerun subfolders.
autodiscovery/*.json.fixed/
autodiscovery/*.json.rerun/

# Credentials and tokens
*.json
zihan_gcs_token.json
*.pem
*.key
credentials.*

